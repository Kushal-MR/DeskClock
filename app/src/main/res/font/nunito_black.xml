<?xml version="1.0" encoding="utf-8"?>
<!--
    Nunito variable font family — bundled TTF with full weight axis.
    weight=900 → ExtraBlack, the rounded, soft-edged numerals we want for
    the clock face. Italic=false keeps the digits upright.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">

    <font
        android:font="@font/nunito_variable"
        android:fontWeight="1000"
        android:fontStyle="normal" />

</font-family>
