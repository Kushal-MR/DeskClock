<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget card background: a very dark, almost-invisible rounded rectangle.
    It gives the right-panel cards a subtle "frosted glass" depth without
    any colour competing with the clock.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Dark charcoal with ~30% opacity -->
    <solid android:color="#4D110800" />

    <!-- Warm glowing border, barely visible -->
    <stroke
        android:width="1dp"
        android:color="#22FF6B35" />

    <corners android:radius="14dp" />
</shape>
